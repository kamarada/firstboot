#!/bin/bash

checkRoot() {
    if [[ $UID != 0 ]]; then
        echo "This option requires sudo:"
        echo "sudo $0 $*"
        exit 1
    fi
}

prepare() {
    checkRoot
    sed -i 's/DEFAULT_WM="gnome"/DEFAULT_WM="openbox"/g' /etc/sysconfig/windowmanager
    echo "kamarada-firstboot" >> /home/linux/.config/openbox/autostart
}

run() {
    mkdir ~/.config
    touch ~/.config/kamarada-firstboot
    while [ -e ~/.config/kamarada-firstboot ]
    do
        python3 /usr/share/kamarada-firstboot.py

        # Read text file
        # https://stackoverflow.com/a/10771857/1657502
        RESULT=$(<~/.config/kamarada-firstboot)

        # Split string
        # https://stackoverflow.com/a/1478245/1657502
        set -- junk $RESULT
        shift
        SELECTED_ACTION=$1
        SELECTED_LANGUAGE=$2

        case "$SELECTED_ACTION" in
            Reboot)
                sudo reboot
                break;;
            Try)
                # TODO Set locale
                #rm ~/.config/kamarada-firstboot
                sudo $0 --restore
                sudo systemctl restart display-manager
                break;;
        esac
    done
}

restore() {
    checkRoot
    sed -i 's/DEFAULT_WM="openbox"/DEFAULT_WM="gnome"/g' /etc/sysconfig/windowmanager
    sed -i '$d' /home/linux/.config/openbox/autostart
}

case "$1" in
    --prepare)
        prepare
        break;;
    --restore)
        restore
        break;;
    *)
        run
        break;;
esac

